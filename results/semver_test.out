CREATE EXTENSION semver;
-- ================================================
-- semver regression tests
-- Covers all requirements from the project manual
-- ================================================
-- ================================================
-- 1. BASIC INPUT AND OUTPUT
-- ================================================
SELECT '1.2.3'::semver;
 semver 
--------
 1.2.3
(1 row)

SELECT '0.0.1'::semver;
 semver 
--------
 0.0.1
(1 row)

SELECT '16.4.0'::semver;
 semver 
--------
 16.4.0
(1 row)

SELECT '20.10.0'::semver;
 semver  
---------
 20.10.0
(1 row)

SELECT '0.0.0'::semver;
 semver 
--------
 0.0.0
(1 row)

-- ================================================
-- 2. INPUT REJECTION (malformed strings)
-- ================================================
SELECT '1.2'::semver;
ERROR:  invalid input syntax for type semver: "1.2"
LINE 1: SELECT '1.2'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT '1.2.3.4'::semver;
ERROR:  invalid input syntax for type semver: "1.2.3.4"
LINE 1: SELECT '1.2.3.4'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT 'v1.2.3'::semver;
ERROR:  invalid input syntax for type semver: "v1.2.3"
LINE 1: SELECT 'v1.2.3'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT '1.2.x'::semver;
ERROR:  invalid input syntax for type semver: "1.2.x"
LINE 1: SELECT '1.2.x'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT ''::semver;
ERROR:  invalid input syntax for type semver: ""
LINE 1: SELECT ''::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT '-1.2.3'::semver;
ERROR:  invalid input syntax for type semver: "-1.2.3"
LINE 1: SELECT '-1.2.3'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT '1.2.3-rc.1'::semver;
ERROR:  invalid input syntax for type semver: "1.2.3-rc.1"
LINE 1: SELECT '1.2.3-rc.1'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
SELECT '1.2.3+build'::semver;
ERROR:  invalid input syntax for type semver: "1.2.3+build"
LINE 1: SELECT '1.2.3+build'::semver;
               ^
HINT:  Expected format: MAJOR.MINOR.PATCH (e.g. 1.2.3)
-- ================================================
-- 3. COMPARISON OPERATORS
-- field-by-field integer comparison, not string
-- ================================================
SELECT '1.2.3'::semver < '1.2.4'::semver AS lt_patch;
 lt_patch 
----------
 t
(1 row)

SELECT '1.2.3'::semver < '1.3.0'::semver AS lt_minor;
 lt_minor 
----------
 t
(1 row)

SELECT '1.2.3'::semver < '2.0.0'::semver AS lt_major;
 lt_major 
----------
 t
(1 row)

SELECT '1.9.0'::semver < '1.10.0'::semver AS lt_critical;
 lt_critical 
-------------
 t
(1 row)

SELECT '1.2.3'::semver <= '1.2.3'::semver AS le_equal;
 le_equal 
----------
 t
(1 row)

SELECT '1.2.3'::semver <= '1.2.4'::semver AS le_less;
 le_less 
---------
 t
(1 row)

SELECT '1.2.3'::semver = '1.2.3'::semver AS eq_true;
 eq_true 
---------
 t
(1 row)

SELECT '1.2.3'::semver = '1.2.4'::semver AS eq_false;
 eq_false 
----------
 f
(1 row)

SELECT '1.2.3'::semver <> '1.2.4'::semver AS ne_true;
 ne_true 
---------
 t
(1 row)

SELECT '1.2.3'::semver <> '1.2.3'::semver AS ne_false;
 ne_false 
----------
 f
(1 row)

SELECT '1.2.3'::semver >= '1.2.3'::semver AS ge_equal;
 ge_equal 
----------
 t
(1 row)

SELECT '1.10.0'::semver >= '1.9.0'::semver AS ge_critical;
 ge_critical 
-------------
 t
(1 row)

SELECT '1.10.0'::semver > '1.9.0'::semver AS gt_critical;
 gt_critical 
-------------
 t
(1 row)

SELECT '2.0.0'::semver > '1.99.99'::semver AS gt_major;
 gt_major 
----------
 t
(1 row)

-- ================================================
-- 4. UTILITY FUNCTIONS
-- ================================================
SELECT major('16.4.0'::semver);
 major 
-------
    16
(1 row)

SELECT minor('16.4.0'::semver);
 minor 
-------
     4
(1 row)

SELECT patch('16.4.0'::semver);
 patch 
-------
     0
(1 row)

SELECT bump_minor('1.2.3'::semver);
 bump_minor 
------------
 1.3.0
(1 row)

SELECT bump_minor('1.9.3'::semver);
 bump_minor 
------------
 1.10.0
(1 row)

SELECT bump_minor('0.0.1'::semver);
 bump_minor 
------------
 0.1.0
(1 row)

SELECT is_compatible('1.5.0'::semver, '1.4.7'::semver);
 is_compatible 
---------------
 t
(1 row)

SELECT is_compatible('1.4.7'::semver, '1.5.0'::semver);
 is_compatible 
---------------
 f
(1 row)

SELECT is_compatible('2.0.0'::semver, '1.9.0'::semver);
 is_compatible 
---------------
 f
(1 row)

SELECT is_compatible('1.0.0'::semver, '1.0.0'::semver);
 is_compatible 
---------------
 t
(1 row)

-- ================================================
-- 5. TABLE OPERATIONS AND ORDER BY
-- ================================================
CREATE TABLE test_packages (name text, version semver);
INSERT INTO test_packages VALUES
    ('postgres', '16.4.0'),
    ('redis',    '7.2.5'),
    ('nginx',    '1.27.1'),
    ('node',     '20.10.0'),
    ('rust',     '1.81.0'),
    ('python',   '3.12.0'),
    ('go',       '1.22.0');
SELECT * FROM test_packages ORDER BY version ASC;
   name   | version 
----------+---------
 go       | 1.22.0
 nginx    | 1.27.1
 rust     | 1.81.0
 python   | 3.12.0
 redis    | 7.2.5
 postgres | 16.4.0
 node     | 20.10.0
(7 rows)

SELECT * FROM test_packages ORDER BY version DESC;
   name   | version 
----------+---------
 node     | 20.10.0
 postgres | 16.4.0
 redis    | 7.2.5
 python   | 3.12.0
 rust     | 1.81.0
 nginx    | 1.27.1
 go       | 1.22.0
(7 rows)

SELECT * FROM test_packages WHERE version >= '2.0.0'::semver ORDER BY version DESC;
   name   | version 
----------+---------
 node     | 20.10.0
 postgres | 16.4.0
 redis    | 7.2.5
 python   | 3.12.0
(4 rows)

SELECT * FROM test_packages WHERE version < '2.0.0'::semver ORDER BY version ASC;
 name  | version 
-------+---------
 go    | 1.22.0
 nginx | 1.27.1
 rust  | 1.81.0
(3 rows)

-- ================================================
-- 6. MAX AND MIN AGGREGATES
-- ================================================
SELECT max(version) FROM test_packages;
   max   
---------
 20.10.0
(1 row)

SELECT min(version) FROM test_packages;
  min   
--------
 1.22.0
(1 row)

-- ================================================
-- 7. COMBINED QUERY (is_compatible demo)
-- ================================================
SELECT name, version, is_compatible(version, '1.0.0'::semver)
FROM test_packages
ORDER BY version DESC;
   name   | version | is_compatible 
----------+---------+---------------
 node     | 20.10.0 | f
 postgres | 16.4.0  | f
 redis    | 7.2.5   | f
 python   | 3.12.0  | f
 rust     | 1.81.0  | t
 nginx    | 1.27.1  | t
 go       | 1.22.0  | t
(7 rows)

-- ================================================
-- cleanup
-- ================================================
DROP TABLE test_packages;
